{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-agent.local/schemas/meeting.schema.json",
  "title": "Meeting",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "startedAt", "captureClockOrigin", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "captureClockOrigin": { "type": "string", "format": "date-time" },
    "status": { "enum": ["idle", "capturing", "finalizing", "analyzing", "completed", "interrupted", "failed", "partially_completed"] }
  }
}
